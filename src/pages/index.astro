<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Enrico Piazza | Platform Management</title>
  </head>
  <body>
    <div class="portfolio-grid">
      <header>Enrico Piazza</header>
      <main>
        <p class="eyebrow">Platform Management · Digital Delivery</p>
        <h1>Making complex digital platforms work.</h1>
        <p class="intro">
          I’m a platform manager who brings business stakeholders and technical
          teams together to deliver and operate digital platforms.
        </p>
      </main>
    </div>
  </body>
</html>

<style>
  html {
    background: #faf9f6;
  }

  body {
    --columns: 4;
    --guide: rgb(36 35 33 / 6%);
    --gutter: clamp(16px, 5%, 56px);
    --content-width: min(76rem, calc(100% - 2 * var(--gutter)));
    --column-width: calc(var(--content-width) / var(--columns));
    margin: 0;
    background-image: linear-gradient(
      to right,
      transparent calc(50% - 0.5px),
      var(--guide) calc(50% - 0.5px) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
    background-size: var(--column-width) 100%;
    /* The center guide is a grid boundary for both even column counts. */
    background-position: center top;
    background-repeat: repeat-x;
    color: #242321;
    font: 400 16px/1.5 system-ui, sans-serif;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    align-content: start;
    width: var(--content-width);
    min-height: 100vh;
    margin-inline: auto;
  }

  header {
    --ruler-ink: #a9a398;
    position: relative;
    grid-column: 1 / -1;
    padding-block: 24px;
    border-bottom: 1px solid var(--ruler-ink);
    font-weight: 650;
  }

  header::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -4px;
    height: 7px;
    background: repeating-linear-gradient(
      to right,
      var(--ruler-ink) 0 1px,
      transparent 1px calc(100% / var(--columns))
    );
    pointer-events: none;
  }

  main {
    grid-column: 1 / -1;
    padding-block: clamp(64px, 13vw, 134px) clamp(76px, 15vw, 156px);
  }

  .eyebrow {
    margin: 0 0 24px;
    color: #56524b;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.35rem, 8.4vw, 6rem);
    font-weight: 650;
    line-height: 1.02;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .intro {
    max-width: 43ch;
    margin: 28px 0 0;
    color: #56524b;
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    line-height: 1.55;
  }

  @media (min-width: 900px) {
    body {
      --columns: 6;
    }

    main {
      grid-column-start: 3;
    }
  }
</style>
